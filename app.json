{
  "expo": {
    "name": "Office Food Manager",
    "slug": "office-food-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "officefood",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0E0C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.officefood.manager"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8A020"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.officefood.manager"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font"
    ],
