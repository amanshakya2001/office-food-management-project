  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-inject Authorization header for all requests",
          "// No action needed — Bearer auth is set at the collection level"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test: flag any non-200 responses",
          "pm.test('Status is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "// Global test: check for Splitwise errors object in response",
          "try {",
          "    const json = pm.response.json();",
          "    if (json.errors && Object.keys(json.errors).length > 0) {",
          "        pm.test('No Splitwise errors', function () {",
          "            pm.expect(Object.keys(json.errors).length).to.equal(0, JSON.stringify(json.errors));",
          "        });",
          "    }",
          "} catch (e) {}",
          "",
          "// Auto-save expense_id after create_expense",
          "try {",
          "    const json = pm.response.json();",
          "    if (json.expenses && json.expenses.length > 0 && json.expenses[0].id) {",
          "        pm.collectionVariables.set('expense_id', json.expenses[0].id);",
          "        console.log('expense_id saved:', json.expenses[0].id);",
          "    }",
          "} catch (e) {}",
          "",
          "// Auto-save current_user_id after get_current_user",
          "try {",
          "    const json = pm.response.json();",
          "    if (json.user && json.user.id) {",
          "        pm.collectionVariables.set('current_user_id', json.user.id);",
          "        console.log('current_user_id saved:', json.user.id);",
          "    }",
          "} catch (e) {}"
        ]
      }
    }
  ]
